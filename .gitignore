# local only — never commit secrets if this folder becomes a git repo
**/__pycache__/
**/*.pyc
**/node_modules/
.env
*.sql
sites/*/site_config.json
sites/*/private/
sites/*/locks/

# PRA reference clones (nested git repos). App code in pra-invoicing/apps/pra is kept.
pra-invoicing/refs/

# Full VPS snapshots. Contain DB dumps, TLS private keys, Frappe encryption_key,
# MariaDB root password and .env files. Never commit, never upload anywhere public.
server-snapshot/

# Playwright MCP snapshots can contain typed credentials
.playwright-mcp/
