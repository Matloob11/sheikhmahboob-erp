[Unit]
Description=Daftar API (PRA desk backend)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=daftar
Group=daftar
WorkingDirectory=/opt/daftar-api
EnvironmentFile=/etc/daftar-api.env
ExecStart=/usr/bin/node dist/src/index.js
Restart=on-failure
RestartSec=5
# Soft cap — leave headroom for Frappe on this 8 GB box.
MemoryMax=400M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
